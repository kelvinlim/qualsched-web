# Copy to .env and fill in. Never commit the real .env.

# --- App ---
ENVIRONMENT=dev
# Keep in sync with backend/pyproject.toml and frontend/package.json.
APP_VERSION=0.0.1

# --- Database ---
# Production / lnpitask (same pattern as wearable-hub): external MariaDB on
# cnc3.med.umn.edu. Provision a NEW schema/user `qualsched` there before first
# start. Do NOT reuse the wearable_hub schema or its credentials.
# Placeholder password only — replace it; never commit a real one.
DB_NAME=qualsched
DB_USER=qualsched
DB_PASSWORD=changeme
DATABASE_URL=mysql+pymysql://qualsched:changeme@cnc3.med.umn.edu:3306/qualsched
# entrypoint.sh waits for the DB on this host:port before running migrations.
DB_WAIT_HOST=cnc3.med.umn.edu
DB_WAIT_PORT=3306

# Local docker-compose only: compose starts a sidecar MariaDB named `db` and the
# backend service overrides DATABASE_URL / DB_WAIT_* to db:3306. Those overrides
# win over this file. Do not add a db service on lnpitask/prod (same as
# wearable-hub compose — no MariaDB container in production).

# SQLite is for pytest (in-memory) only. An explicit sqlite:/// URL is an escape
# hatch, not the default first-run. The entrypoint skips the network wait for sqlite*.

# --- Token encryption at rest (Fernet) ---
# Used for Qualtrics API tokens AND the researcher session cookie.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- Researcher auth (Google login + allowlist) ---
# Bootstrap superadmin emails (comma-separated) — auto-provisioned as superusers on
# first Google login (or on the documented dev-login when Google is unset).
SUPERADMIN_EMAILS=

# Optional Google OAuth. Reuses a Cloud Console OAuth client (openid email profile).
# Leave blank to use the documented local dev-login instead.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Researcher login callback — add this exact URI to the Google OAuth client's redirect URIs.
# Local compose/Vite: http://localhost:8040/auth/callback
# Path-based prod (host nginx; do NOT occupy /wearable):
#   https://lnpitask.umn.edu/qualsched/auth/callback
RESEARCHER_OAUTH_REDIRECT_URI=http://localhost:8040/auth/callback

# Public URL path prefix the app would be served under on lnpitask (e.g. "/qualsched").
# Backend routes stay unprefixed; host nginx would strip the prefix.
# Do not use /wearable or collide with wearable-hub ports 8000 / 8010 / 8020.
PUBLIC_PATH_PREFIX=
